                                  <xs:documentation>Alíquota da CBS incidente sobre a operação.</xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                  <xs:restriction base="xs:string">
                                    <xs:whiteSpace value="preserve"/>
                                    <xs:minLength value="8"/>
